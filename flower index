  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #fffafc;
      color: #292329;
    }

    /* HEADER */
    header {
      background: linear-gradient(135deg, #8e44ad, #e84393);
      color: white;
      padding: 45px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    header p {
      font-size: 1.1rem;
      opacity: 0.95;
    }

    /* SEARCH */
    .search-container {
      max-width: 700px;
      margin: -25px auto 30px;
      padding: 0 20px;
      position: relative;
    }

    #search {
      width: 100%;
      padding: 18px 22px;
      border: none;
      border-radius: 50px;
      font-size: 1rem;
      box-shadow: 0 5px 25px rgba(0,0,0,0.12);
      outline: none;
    }

    /* FILTERS */
    .filters {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 10px 20px 30px;
    }

    .filter-btn {
      border: none;
      padding: 10px 18px;
      border-radius: 30px;
      background: #f0d9ed;
      cursor: pointer;
      font-weight: bold;
      transition: 0.2s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: #d63384;
      color: white;
    }

    /* FLOWER GRID */
    .flower-grid {
      max-width: 1300px;
      margin: auto;
      padding: 10px 25px 60px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    /* CARD */
    .flower-card {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .flower-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }

    .flower-image {
      width: 100%;
      height: 210px;
      object-fit: cover;
      background: #eee;
    }

    .flower-info {
      padding: 20px;
    }

    .flower-info h2 {
      margin-bottom: 5px;
      color: #8e44ad;
    }

    .scientific {
      font-style: italic;
      color: #777;
      margin-bottom: 12px;
    }

    .flower-info p {
      line-height: 1.5;
      margin-bottom: 8px;
    }

    .tag {
      display: inline-block;
      margin-top: 8px;
      padding: 5px 10px;
      border-radius: 15px;
      background: #f8e7f4;
      color: #8e44ad;
      font-size: 0.8rem;
      font-weight: bold;
    }

    /* FOOTER */
    footer {
      background: #292329;
      color: white;
      text-align: center;
      padding: 30px 20px;
    }

    footer p {
      margin: 5px;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 2.2rem;
      }

      .flower-grid {
        padding: 10px 15px 40px;
      }
    }
  </style>
</head>

